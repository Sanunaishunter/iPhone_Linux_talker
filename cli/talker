#!/usr/bin/env python3
"""talker: Ubuntu-side helper for iPhone_Linux_talker.

  talker send [text]   queue text for the iPhone to pull (arg, stdin, or current clipboard)
  talker show          print what is queued
  talker clear         empty the queue
  talker init          create the token if missing
  talker token         print the token (for the iPhone Shortcut)
  talker info          print the URL values to put in the iPhone Shortcut
"""
import os
import secrets
import subprocess
import sys
from pathlib import Path

CONF_DIR = Path(os.environ.get("TALKER_CONF", Path.home() / ".config/iphone_linux_talker"))
STATE_DIR = Path(os.environ.get("TALKER_STATE", Path.home() / ".local/state/iphone_linux_talker"))
TOKEN_FILE = CONF_DIR / "token"
OUTBOX = STATE_DIR / "outbox.txt"
PORT = os.environ.get("TALKER_PORT", "8787")


def notify(msg):
    subprocess.run(["notify-send", "-t", "2000", "-h", "string:transient:1", "Ubuntu → iPhone", msg],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def init():
    CONF_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    if not TOKEN_FILE.exists():
        fd = os.open(TOKEN_FILE, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(secrets.token_urlsafe(32) + "\n")
        print(f"created {TOKEN_FILE}")


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "send"
    if cmd == "init":
        return init()
    if cmd == "token":
        return print(TOKEN_FILE.read_text().strip())
    if cmd == "info":
        ip = subprocess.run(["tailscale", "ip", "-4"], capture_output=True, text=True).stdout.split()
        host = ip[0] if ip else "<tailscale-ip>"
        print(f"Push URL: http://{host}:{PORT}/push\nPull URL: http://{host}:{PORT}/pull\n"
              f"Header:   Authorization: Bearer {TOKEN_FILE.read_text().strip()}")
        return
    if cmd == "show":
        return sys.stdout.write(OUTBOX.read_text(encoding="utf-8") if OUTBOX.exists() else "")
    if cmd == "clear":
        OUTBOX.unlink(missing_ok=True)
        return
    if cmd == "send":
        args = sys.argv[2:]
        if args:
            text = " ".join(args)
        elif not sys.stdin.isatty():
            text = sys.stdin.read()
        else:
            text = subprocess.run(["wl-paste", "--no-newline"], capture_output=True, text=True).stdout
        if not text:
            sys.exit("nothing to send")
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        tmp = OUTBOX.with_suffix(".tmp")
        tmp.write_text(text, encoding="utf-8")
        tmp.replace(OUTBOX)
        notify(f"已排入 {len(text)} 字，iPhone 執行 Pull 捷徑即可取得")
        return
    sys.exit(__doc__)


if __name__ == "__main__":
    main()
