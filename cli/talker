#!/usr/bin/env python3
"""talker: Ubuntu-side helper for iPhone_Linux_talker (talks to the local server).

  talker send [text]   send text to the iPhone (arg, stdin, or current clipboard)
  talker log           print recent messages
  talker clear         clear the message history
  talker ui            open the chat page in the browser
  talker init          create the token if missing
  talker token         print the token
  talker info          print the URLs / header for the iPhone Shortcuts
"""
import json
import os
import secrets
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

CONF_DIR = Path(os.environ.get("TALKER_CONF", Path.home() / ".config/iphone_linux_talker"))
TOKEN_FILE = CONF_DIR / "token"
PORT = os.environ.get("TALKER_PORT", "8787")
BASE = f"http://127.0.0.1:{PORT}"


def notify(msg):
    subprocess.run(["notify-send", "-t", "2000", "-h", "string:transient:1", "Ubuntu → iPhone", msg],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def init():
    CONF_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    if not TOKEN_FILE.exists():
        fd = os.open(TOKEN_FILE, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(secrets.token_urlsafe(32) + "\n")
        print(f"created {TOKEN_FILE}")


def call(path, body=None):
    req = urllib.request.Request(BASE + path, headers={"X-Token": TOKEN_FILE.read_text().strip()},
                                 data=None if body is None else json.dumps(body).encode(),
                                 method="GET" if body is None else "POST")
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    try:
        with opener.open(req, timeout=5) as r:
            return json.loads(r.read())
    except (urllib.error.URLError, OSError) as e:
        sys.exit(f"cannot reach the talker service ({e}); try: systemctl --user status iphone-linux-talker")


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "send"
    if cmd == "init":
        return init()
    if cmd == "token":
        return print(TOKEN_FILE.read_text().strip())
    if cmd == "info":
        ip = subprocess.run(["tailscale", "ip", "-4"], capture_output=True, text=True).stdout.split()
        host = ip[0] if ip else "<tailscale-ip>"
        print(f"Push URL: http://{host}:{PORT}/push\nPull URL: http://{host}:{PORT}/pull\n"
              f"Header:   X-Token: {TOKEN_FILE.read_text().strip()}\nWeb UI:   http://127.0.0.1:{PORT}/")
        return
    if cmd == "ui":
        return subprocess.run(["xdg-open", f"{BASE}/"])
    if cmd == "log":
        for m in call("/api/state")["messages"]:
            when = time.strftime("%m-%d %H:%M", time.localtime(m["ts"]))
            note = "" if m["to"] != "iPhone" else (" [pulled]" if m.get("delivered") else " [waiting]")
            print(f"{when}  {m['from']} -> {m['to']}{note}: {m['text']}")
        return
    if cmd == "clear":
        return call("/api/clear", {})
    if cmd == "send":
        args = sys.argv[2:]
        if args:
            text = " ".join(args)
        elif not sys.stdin.isatty():
            text = sys.stdin.read()
        else:
            text = subprocess.run(["wl-paste", "--no-newline"], capture_output=True, text=True).stdout
        if not text.strip():
            sys.exit("nothing to send")
        call("/api/send", {"text": text})
        notify(f"已排入 {len(text)} 字，iPhone 執行 Pull 捷徑即可取得")
        return
    sys.exit(__doc__)


if __name__ == "__main__":
    main()
